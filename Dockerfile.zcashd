# Use official Zcash image
FROM electriccoinco/zcashd:latest

# Create configuration directory
RUN mkdir -p /root/.zcash

# Create zcash.conf
# Defaults to Testnet for faster sync and testing
RUN echo "testnet=1" > /root/.zcash/zcash.conf && \
    echo "addnode=testnet.z.cash" >> /root/.zcash/zcash.conf && \
    echo "rpcuser=zcashrpc" >> /root/.zcash/zcash.conf && \
    echo "rpcpassword=password" >> /root/.zcash/zcash.conf && \
    echo "rpcport=18232" >> /root/.zcash/zcash.conf && \
    echo "rpcallowip=0.0.0.0/0" >> /root/.zcash/zcash.conf && \
    echo "txindex=1" >> /root/.zcash/zcash.conf && \
    echo "experimentalfeatures=1" >> /root/.zcash/zcash.conf && \
    echo "insightexplorer=1" >> /root/.zcash/zcash.conf

# Expose RPC port (Testnet)
EXPOSE 18232

# Start zcashd
CMD ["zcashd", "-printtoconsole"]
